# Copie este arquivo para .env e substitua os valores.

# Porta HTTP usada pela aplicação
PORT=5173

# Credenciais do painel administrativo
ADMIN_EMAIL=admin@napne.gov.br
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Supabase (Settings > API no painel do projeto)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
# Nunca exponha esta chave no navegador ou em repositórios
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
